# Proveedor del modelo: anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Solo la clave del proveedor elegido. Nunca se envía al front ni se escribe en logs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Opcional: endpoint compatible con OpenAI (Azure, local, etc.)
OPENAI_BASE_URL=

# Límites de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
MAX_TOKENS_RESPUESTA=2048
LLM_TIMEOUT_MS=60000
MAX_SESIONES=200
MAX_LARGO_MENSAJE=4000

# Servidor
PORT=3000
# Opcional: si se define, el chat pide esta clave (cabecera x-access-key)
APP_ACCESS_KEY=
